{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Keysy",
  "colors": {
    "primary": "#1d4ed8",
    "light": "#7aa2ff",
    "dark": "#2f5aba"
  },
  "background": {
    "color": {
      "light": "#fafafa",
      "dark": "#121212"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "General",
            "pages": ["index", "prd"]
