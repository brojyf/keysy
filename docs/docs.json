        "groups": [
          { "group": "General", "pages": ["api/overview"] },
          { "group": "API endpoints", "pages": ["api/endpoints"] }
        ]
      },
      {
        "tab": "Auth",
        "groups": [
          { "group": "General", "pages": ["auth/overview"] },
          { "group": "API endpoints", "pages": ["auth/endpoints"] }
        ]
      },
      {
        "tab": "Notify",
        "groups": [
          { "group": "General", "pages": ["notify/overview"] },
          { "group": "API endpoints", "pages": ["notify/endpoints"] }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          { "group": "General", "pages": ["cli/overview"] },
          { "group": "API endpoints", "pages": ["cli/endpoints"] }
        ]
      },
      {
        "tab": "Web",
        "groups": [
          { "group": "General", "pages": ["web/overview"] },
          { "group": "API endpoints", "pages": ["web/endpoints"] }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "icon": { "name": "github", "style": "brands" },
        "href": "https://github.com/brojyf/keysy"
