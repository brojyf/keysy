  "cards": [
    {
      "dot": "emerald",
      "title": "Reliability",
      "items": [
        "Outbox row commits in the same transaction as business data",
        "Kafka keyed by aggregate ID; failed events go to a DLQ topic",
        "notify commits its offset only after the enqueue succeeds"
      ]
    },
    {
      "dot": "rose",
      "title": "Audit",
      "items": [
        "api authorizes the user, then queries the audit read API",
        "Only audit reads or writes the audit database"
      ]
    },
    {
      "dot": "amber",
      "title": "Email delivery",
      "items": [
        "notify picks recipient and template; job_id = hash(event_id + template)",
        "email-high: security alerts and invites; email-low: everything else",
        "email-worker sends with Idempotency-Key = job_id; 429/5xx retried with delay",
        "Bounces and complaints handled by the Resend suppression list"
      ]
    },
    {
      "dot": "cyan",
      "title": "Observability",
      "items": [
        "api, auth, Outbox Relay, audit and notify export OTLP to otel; only the api edge is drawn",
        "email-worker exports logs and traces to Grafana via Cloudflare OTLP export; final send failures raise an alert",
        "email-dlq keeps failed jobs for 4 days so they can be replayed"
      ]
    }
  ]
