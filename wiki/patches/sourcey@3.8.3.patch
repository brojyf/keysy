+  // Animate collapsible nav groups; reduced motion keeps the native toggle.
+  function initNavGroupMotion() {
+    document.querySelectorAll('details.sourcey-nav-group').forEach(function (group) {
+      var summary = group.querySelector(':scope > summary');
+      var list = group.querySelector(':scope > ul');
+      if (!summary || !list || !list.animate) return;
+      summary.addEventListener('click', function (e) {
+        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+        e.preventDefault();
+        var opening = !group.open;
+        if (opening) group.open = true;
+        else group.dataset.closing = '';
+        var height = list.scrollHeight + 'px';
+        list.animate(
+          { height: opening ? ['0px', height] : [height, '0px'], overflow: ['hidden', 'hidden'] },
+          { duration: 200, easing: 'ease-in-out' }
+        ).onfinish = function () {
+          if (opening) return;
+          group.open = false;
+          delete group.dataset.closing;
+        };
+      });
+    });
+  }
+
   function init() {
     initDesktopSidebarScroll();
+    initNavGroupMotion();
 
     var dialog = document.getElementById('mobile-nav');
     var openBtns = document.querySelectorAll('[data-drawer-slide]');
     if (!dialog) return;
 
+    // Focus the drawer itself on open, not its first link (the logo).
+    dialog.autofocus = true;
+
     window.matchMedia('(min-width: 1024px)').addEventListener('change', function (event) {
       if (event.matches && dialog.open) dialog.close();
     });
@@ -192,11 +221,27 @@
       if (e.target === dialog) dialog.close();
     });
 
-    // Close on nav link or close button click
+    // Preserve the open drawer until cross-document navigation captures it.
+    // Closing here can remove its snapshot before the outgoing slide starts.
     dialog.addEventListener('click', function (e) {
+      var link = e.target.closest('a[href]');
+      if (dialog.open && 'CSSViewTransitionRule' in window &&
+          window.matchMedia('(width < 64rem) and (prefers-reduced-motion: no-preference)').matches &&
+          shouldSaveForNavigation(e, link) &&
+          (link.pathname !== window.location.pathname || link.search !== window.location.search)) {
+        return;
+      }
       if (e.target.closest('a') || e.target.closest('[data-close-drawer]')) dialog.close();
     });
 
+    // A cached outgoing document must not restore with its drawer still open.
+    window.addEventListener('pageshow', function (event) {
+      if (event.persisted && dialog.open) {
+        dialog.close();
+        dialog.getAnimations().forEach(function (animation) { animation.finish(); });
+      }
+    });
+
     // Dropdown: toggle list visibility
     var toggle = document.getElementById('drawer-group-toggle');
     var list = document.getElementById('drawer-group-list');
