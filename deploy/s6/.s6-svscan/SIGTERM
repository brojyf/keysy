#!/bin/sh
# s6-svscan runs this on SIGTERM, in the scan directory, instead of stopping all services at once.
# api, auth, and notify send buffered telemetry after they stop, so the collector stops last.
for service in nginx api auth notify; do s6-svc -d "$service"; done
# api, auth, and notify send telemetry. 10 s is their own shutdown limit and leaves the collector 5 s of Fly's 15 s.
s6-svwait -d -t 10000 api auth notify
exec s6-svscanctl -t .
